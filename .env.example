# 起站试用版的部署品牌配置。默认值已是独立品牌。
VITE_SITE_NAME=起站
VITE_SITE_DESCRIPTOR=AI 建站入门
VITE_SITE_DESCRIPTION=起站 — 帮助 AI 建站初学者理解关键概念并完成第一个网页。
VITE_SITE_LOGO=/qizhan-mark.svg
VITE_SITE_FAVICON=/qizhan-mark.svg

# VibeHub local development / deployment: leave unset for the static-only launch build.
# Vite development also falls back to http://127.0.0.1:3000 when this is omitted.
# VITE_API_BASE_URL=http://127.0.0.1:3000

# Complete replica line (npm run dev:vibehub / npm run build:vibehub)
# VITE_SITE_INDEPENDENT=true
# VITE_SITE_NAME=起站
# VITE_SITE_DESCRIPTOR=Vibe Coding 术语图鉴
# VITE_SITE_LOGO=/assets/brand-mark.svg
# VITE_SITE_FAVICON=/assets/brand-mark.svg
