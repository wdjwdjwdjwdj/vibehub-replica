",好的:"OK",模板:"Templates",统计:"Statistics",移出:"Remove",清空:"Clear",返回:"Back",分享:"Share",完成:"Complete",下单:"Place order",支付:"Pay",收货:"Receive order",头像:"Avatar",昵称:"Nickname",签名:"Signature",填写:"Fill in",验证:"Verify",协议:"Agreement",问卷:"Survey",上传:"Upload",更多:"More",新建:"New",移动到:"Move to",背景:"Background",方案:"Approach",风险:"Risks",结论:"Conclusion",安装:"Install",特性:"Features",日:"Day",周:"Week",月:"Month",一级:"Level 1",二级:"Level 2",三级:"Level 3",展开:"Expand",值:"Value",用:"Y",协:"C",脸:"Face",我:"Me",人:"people",小:"Small",大:"Large",每天:"Every day",组:"Team",区:"District",街道:"Subdistrict",审核:"Review",成功:"Success","设计稿.sketch":"Design.sketch","需求文档.md":"Requirements.md",">南山<":">Nanshan<","林小hu 更新于 3 天前 \xb7 仅自己可见":"Alex Chen updated 3 days ago \xb7 visible only to you","姓　　名：林小hu":"Name: Alex Chen","手机号码：138 0000 0000":"Phone: 138 0000 0000","价格　　　　\xa5 199":"Price: \xa5199",标准配送:"Standard delivery",加急配送:"Express delivery","coding 入门":" coding basics",设计规范:" design guidelines","\uD83D\uDD0D 搜索组件…":"\uD83D\uDD0D Search components…","进行中 ▸":"In progress ▸","广东省 / 深圳市 /":"Guangdong / Shenzhen /","广东省 / 广州市 /":"Guangdong / Guangzhou /","研发部 /":"Engineering /","设计部 /":"Design /","▾ 北京":"▾ Beijing",一:"Mon",二:"Tue",三:"Wed",四:"Thu",五:"Fri",六:"Sat","\uD83D\uDD0D 搜索用户名":"\uD83D\uDD0D Search usernames",发布时间:"Published","林小hu 有 3 条新动态":"Alex Chen has 3 new updates",前端工程师:"Frontend engineer","▸ 更多设置":"▸ More settings","项目 A":"Project A","项目 B":"Project B","项目 C":"Project C","▾ 一级":"▾ Level 1","▾ 二级":"▾ Level 2","三级…":"Level 3…",全部展开:"Expand all","⚠ 加载失败":"⚠ Couldn’t load",编辑成员:"Edit member","⚠ 确认删除这条记录？":"⚠ Delete this record?","⚠ 确认删除全部 1,024 条数据？此操作不可恢复！":"⚠ Delete all 1,024 records? This can’t be undone!","首页.sketch":"Home.sketch",找到:"Found",条结果:"results","更多 ▾":"More ▾","保存 ⌘S":"Save ⌘S","另存为 ⇧⌘S":"Save As ⇧⌘S","导出 ⌘E":"Export ⌘E","请选择城市 ▾":"Select a city ▾","移动到 ▸":"Move to ▸","“好的设计是尽可能少的设计。”":"“Good design is as little design as possible.”",会员权益说明:"Membership benefits",保存:"Save","值 A":"Value A","值 B":"Value B","值 C":"Value C",关注我:"Follow me","只写 Georgia，中文掉成浏览器默认衬线":"With only Georgia specified, Chinese falls back to the browser’s default serif.","同类元素没有统一规则，界面关系难以辨认":"Without consistent rules for similar elements, the interface relationships are hard to read.","同级标题两种字体混用，气质分裂":"Mixing two typefaces at the same heading level splits the visual tone.","告警 3":"3 alerts",团队成员:"Team members","圆弧更明显，需要结合组件尺寸判断":"The curve is more pronounced; judge it in relation to the component’s size.","夏日活动今天开始，登录后即可领取奖励":"The summer promotion starts today. Sign in to claim your reward.",大圆角卡片:"Large-radius card",大圆角按钮:"Large-radius button",大圆角输入框:"Large-radius input","字号、字重或渲染不合适时，正文可读性会下降":"Poor type size, weight, or rendering reduces body-text readability.","工程工具硬凹优雅，气质错位":"Forcing an elegant tone onto an engineering tool creates a mismatch.",开始:"Start","引文可用不同字体形成对比，但仍需匹配语言与语境":"Quotes can use a contrasting typeface, but it still needs to suit the language and context.",恒丰私人银行:"Evergreen Private Bank","恒丰银行 \xb7 大额转账":"Evergreen Bank \xb7 Large transfer","所有层级使用相同显著圆角，组件角色不易区分":"Using the same prominent radius at every level makes component roles harder to distinguish.","按钮轮廓与页面其他控件差异过大，可能削弱整体一致性":"A button outline that differs too much from other controls can weaken overall consistency.","数值没有对应组件角色或设计 token":"The values do not correspond to component roles or design tokens.",数据看板:"Data dashboard",服务器监控大盘:"Server monitoring dashboard",本月目标:"This month’s goals",林:"L",正常:"Normal","界面用非衬线：干净、高效、读得快":"Use sans-serif in interfaces: clean, efficient, and easy to scan.","直角保留清楚边缘，感受还取决于边框、字体和间距":"Square corners keep edges crisp; the feel also depends on borders, type, and spacing.",直角卡片:"Square-corner card",相对尺寸较小的圆角仍保留明显边缘:"A relatively small radius still preserves a clear edge.",确定:"Confirm",立即体验:"Try it now",立即转账:"Transfer now",胶囊和圆形由半径与组件比例共同形成:"Pills and circles come from the relationship between radius and component proportions.","衬线大标题，自带编辑感":"A serif display headline creates an editorial feel.",设计指南:"Design Guide",设计的气质:"The character of design",负责人:"Owner",较大圆角卡片:"Larger-radius card",较小圆角卡片:"Smaller-radius card","这是一段用小字号衬线字体排版的长正文。在当前屏幕和字重下，笔画细节不够清楚。":"This is a long body paragraph set in a small serif. At this screen size and weight, the letter details are not clear enough.","金融、律所：衬线 = 可信赖":"Finance and law firms: serif = trustworthy",项目名称:"Project name","全局 ::selection 会影响全站；也可按组件范围定义":"Global ::selection affects the entire site; it can also be scoped to individual components.","同一段话，":"In the same sentence, ","同页选中色不一致，降低界面一致性":"Inconsistent selection colors on one page reduce interface consistency.",拖动点击区域时意外选中了按钮文字:"Dragging over the click target accidentally selected the button label.","拖选一段文字，":"Drag to select some text, ","按钮、图片防止被误选":"Prevent accidental selection on buttons and images",按钮文字被选中:"Button label selected",有一部分被选中:"part of it is selected","正文设置了 user-select: none，用户无法选中并复制需要的内容。":"The body copy uses user-select: none, so people cannot select and copy what they need.","浅底深字 ✓":"Light background, dark text ✓","深底白字 ✓":"Dark background, white text ✓",这一段被选中了:"this part is selected",这段话中:"In this sentence",选中背景与文字需要保持清楚对比:"The selection background and text need clear contrast.",选中色换成品牌色:"Use the brand color for selection","选中颜色过浅，用户难以识别范围":"The selection color is too light for people to see its extent.",选区:"Selection",防误选规则不应覆盖正文:"Accidental-selection safeguards should not cover body copy.",默认样式通常已经能清楚表达选中状态:"The default style usually communicates selection clearly.","，但状态不明显。":", but the state is not clear.","，先确认对比度与作用范围。":", first confirm its contrast and scope.","，颜色由浏览器和系统决定。":", and the colors are determined by the browser and operating system.","display: grid + place-items: center，两行收工":"display: grid + place-items: center gets it done in two lines.","fixed 钉在视口右下角，滚动不跟走":"fixed pins it to the viewport’s lower-right corner; it does not scroll away.","table-cell 能居中；新布局通常用 flex 或 grid 更直接":"table-cell can center content, but flex or grid is usually more direct for new layouts.","text-align: center 只管水平方向":"text-align: center only handles the horizontal axis.","全写死坐标，内容一变长全错位":"Hard-coded coordinates break as soon as content gets longer.","卡片没写 relative，absolute 参照了 body":"Without relative on the card, absolute positioning is relative to the body.","只写 left/top: 50%，元素从中心往右下长":"With only left/top: 50%, the element grows down and right from the center.","宽度没定死，margin: 0 auto 居不了中":"Without a fixed width, margin: 0 auto cannot center it.",标题水平居中:"Headline centered horizontally","父卡片 relative，角标 absolute 贴右上角":"The parent card is relative; the absolute badge sits in its upper-right corner.","用固定 margin 定位，容器变宽后会偏移":"Positioning with a fixed margin shifts when the container gets wider.",角标飞到角落:"Badge flies into the corner","auto-fill + minmax，容器多宽就几列":"auto-fill + minmax: the number of columns follows the container width.","flex: 1 \xb7 占用剩余宽度":"flex: 1 \xb7 takes the remaining width","gap 一处声明，横竖格距全统一":"Declare gap once to keep horizontal and vertical spacing consistent.","logo 靠左、导航居中、主操作靠右":"Logo left, navigation centered, primary action right.","↔ 一行 60~75 字符":"↔ 60–75 characters per line","一行 150 字，读完找不到下一行":"At 150 characters per line, you lose your place finding the next one.",三栏等宽会压缩主要正文的可用宽度:"Three equal columns squeeze the space available for the main body.","两侧空白不是浪费，是聚焦的代价":"Whitespace on both sides is not waste; it is the cost of focus.","主要行动只在页面末尾出现，阅读过程中缺少可用入口":"The primary action appears only at the end, leaving no usable entry point while reading.","产品 \xb7 文档 \xb7 定价":"Product \xb7 Docs \xb7 Pricing",使用底色或分割线区分顶栏与内容:"Use a background color or divider to separate the top bar from content.","先说明价值，再提供理由与证据，最后给出下一步":"State the value first, then provide reasons and evidence, and finally offer the next step.",免费试用:"Free trial","入口过多，顶栏在较窄宽度下换行":"Too many entry points make the top bar wrap at narrower widths.",公告:"Announcement","内容写死宽度，侧栏一收就露白缝":"Fixed-width content leaves a blank gap when the sidebar collapses.","内容定宽居中，两侧留白":"Fixed-width content centered with whitespace on both sides",内容栏:"Content column","列数写死，窄屏直接溢出":"A fixed column count overflows on narrow screens.","卡片未居中，两侧留白失衡":"The card is off-center, leaving unbalanced whitespace on the sides.","卡片结构不一致，列表扫描效率降低":"Inconsistent card structures make the list harder to scan.","同一章节混入多个主题，主线不清晰":"Mixing several topics into one section obscures the main thread.","同行卡片一样高，墙面才整齐":"Cards in the same row need equal height to keep the wall tidy.",大纲:"Outline","容器居中 ≠ 文字居中对齐":"Centering a container ≠ center-aligning its text","宽屏内容未限宽，行长过长影响阅读":"Unconstrained content on wide screens creates lines that are too long to read comfortably.","导航里混着公告广告，找不到入口":"Announcements and ads mixed into navigation make entry points hard to find.","屏幕变窄时先折叠右侧大纲，为正文保留空间":"As the screen narrows, collapse the right outline first to preserve room for the body.","左侧跨页面导航，中间承载正文，右侧定位当前章节":"Cross-page navigation on the left, body content in the middle, and the current section on the right.",广告:"Ad","按内容关系组织连续章节，并让分段边界清楚":"Organize consecutive sections around content relationships and make section boundaries clear.","收起只剩图标，内容区自动变宽":"Collapse to icons only and let the content area widen automatically.","放任内容撑高度，整面墙高高低低":"Letting content set the height makes the whole wall uneven.",正文:"Body","正文随窗口拉宽，行长过长影响阅读":"As the window widens, body lines become too long to read comfortably.","滚多远，导航都在手边":"No matter how far you scroll, navigation stays within reach.",登录卡片:"Sign-in card",目录:"Contents","眼球不用长途移动，长文最好读":"Less eye travel makes long-form reading easier.","移动端保留三栏，正文可用宽度不足":"Keeping three columns on mobile leaves too little width for the body.","移动端保留全宽侧栏，正文可用宽度不足":"Keeping a full-width sidebar on mobile leaves too little width for the body.",窄版心不适合同时展示多列仪表盘指标:"A narrow content column is not suited to showing multiple dashboard metrics side by side.",缺少视觉分层:"Lacks visual layering","这是一段居中对齐的长正文，每行的起点都不一样，读两行就开始费劲。":"This is a long center-aligned paragraph. Every line starts somewhere different, making it tiring after only two lines.",长页面缺少锚点和返回顶部入口:"The long page lacks anchors and a back-to-top entry point.","顶栏 \xb7 position: sticky":"Top bar \xb7 position: sticky",顶栏与正文底色相同:"Top bar and body share the same background color","2026 年度产品规划与路线图最终确认版本":"Final confirmed version of the 2026 product plan and roadmap","2026-08-01 截止":"Due Aug 1, 2026","fixed 栏":"Fixed bar","fixed 脱离文档流，把第一行内容盖住了":"fixed removes the bar from document flow and covers the first line of content.","rgba 半透明底色 + blur，一对搭档":"A translucent rgba background + blur: a natural pair.","三件套缺一不可：overflow + nowrap + ellipsis":"All three are required: overflow + nowrap + ellipsis.","不透明背景 = 毛玻璃完全不生效":"An opaque background means the frosted-glass effect cannot work.","任务　　状态":"Task\xa0\xa0\xa0\xa0 Status",先保证文字对比度和可读性:"Ensure text contrast and readability first.","关于召开 2026 年第三季度产品战略评审会的通知":"Notice: 2026 Q3 Product Strategy Review Meeting","内容从导航底下过，若隐若现":"Content passes beneath the navigation, partly visible.","只写了 text-overflow: ellipsis 的标题，照样换行溢出":"A title with only text-overflow: ellipsis still wraps and overflows.","可能限制 sticky 的滚动范围":"May limit sticky’s scroll range","同时吸附多层控件，会显著压缩内容的可视区域":"Sticking several layers of controls at once significantly shrinks the visible content area.",吸顶导航:"Sticky navigation",吸顶筛选:"Sticky filters",吸顶表头:"Sticky table header","大面积重度模糊，又卡又看不清":"Heavy blur over a large area is both slow and hard to read.","字母分组标题，滚动时依次接力吸顶":"Alphabetical group headings take turns sticking as you scroll.","对话框 \xb7 毛玻璃浮层":"Dialog \xb7 Frosted-glass overlay","导航 \xb7 毛玻璃":"Navigation \xb7 Frosted glass","山居民宿 \xb7 云顶":"Mountain Lodge \xb7 Cloud Peak","截断了，点不开也没提示，全文去哪看？":"It is truncated, not clickable, and offers no hint—where can I read the full text?","支付流程　已完成":"Payment flow\xa0\xa0\xa0\xa0 Complete",整页内容罩一层重模糊:"A heavy blur covers the entire page.","未设背景色，滚动内容会与标题叠加":"Without a background color, scrolling content overlaps the heading.","本次规划围绕课程体系重构、实战项目升级与社群运营三条主线展开，具体排期与负责人见附录详情。":"This plan focuses on rebuilding the curriculum, upgrading hands-on projects, and running the community. See the appendix for the detailed schedule and owners.","标题一行省略，摘要两行截断":"Truncate the title to one line and the summary to two.","标题可单行省略，但要留查看全名的入口":"A title may truncate to one line, but provide a way to view the full name.","检查祖先 overflow、滚动容器和可滚动高度":"Check ancestor overflow, the scroll container, and the available scroll height.","正文应自然换行，不应使用 nowrap 强制截断":"Body copy should wrap naturally; do not force it to truncate with nowrap.","浮层既独立，又和页面保持联系":"The overlay is distinct while remaining connected to the page.","滚到顶部才吸住，之前跟着内容走":"It sticks only when it reaches the top; before that, it moves with the content.","登录页改版　进行中":"Sign-in page redesign\xa0\xa0\xa0\xa0 In progress",白老师:"Ms. Bai","祖先：overflow: hidden":"Ancestor: overflow: hidden","移动端叠加多层模糊，可能影响低性能设备流畅度":"Stacking several blur layers on mobile can hurt performance on lower-end devices.","筛选栏 \xb7 sticky 吸顶":"Filter bar \xb7 sticky at top","背景写了纯白，blur 白写了":"A solid white background makes blur pointless.","背景透明度过高且模糊不足时，正文会与背景互相干扰。":"When the background is too transparent and not blurred enough, the body text and background interfere with each other.","这是一段本该自然换行的正文，结果被强制塞进一行，后半截直接看不见了，读者还以为内容就这么多。":"This body copy should wrap naturally, but it has been forced onto one line. The second half disappears, so readers may think that is all there is.",透明背景的吸顶标题:"Sticky heading with a transparent background","金额和日期被截断，关键信息不完整":"The amount and date are truncated, leaving key information incomplete.","长表格滚下来，表头吸在顶部":"As the long table scrolls, its header stays pinned at the top.","阈值不写，sticky 永远不吸":"Without a threshold, sticky never sticks.",阿凯:"Kai","风景图上的玻璃卡，轻盈有层级":"A glass card over a landscape image feels light and layered.","\uD83D\uDCC4 2026-年度产品规划-final-v3-最终确认版.sketch":"\uD83D\uDCC4 2026-product-plan-final-v3-confirmed.sketch","\uD83D\uDCC4 设计系统组件覆盖率审计报告-对外发布版.pdf":"\uD83D\uDCC4 design-system-component-coverage-audit-public.pdf","1px 浅灰描边，对比度不足":"1px light-gray border; insufficient contrast","Tab 从上到下走，顺序符合阅读预期":"Tab moves from top to bottom in an order that matches reading expectations.","div 模拟按钮未补全键盘语义，Tab 无法正常聚焦":"A div used as a button lacks keyboard semantics, so Tab cannot focus it properly.","tabindex 顺序不合理，焦点移动不符合操作流程":"An illogical tabindex order makes focus move against the task flow.","① 姓名":"① Name","① 邮箱":"① Email","② 姓名":"② Name","② 邮箱":"② Email","③ 电话":"③ Phone","不可用状态与可用态差异不足，用户可能误判为可操作":"The unavailable state differs too little from the available one, so people may mistake it for actionable.","不适合缩放时，可通过颜色变化表达按下状态":"When scaling is unsuitable, use a color change to show the pressed state.","两种状态外观相同，用户难以确认是否已经按下":"The two states look the same, so people cannot tell whether it has been pressed.","仅显示不可用，没有说明缺少规格、库存或权限等原因":"It only says unavailable, without explaining whether specifications, stock, or permissions are missing.","任务 A":"Task A","任务 B":"Task B","任务 B（拖拽中）":"Task B (dragging)","任务 C":"Task C","关键规则仅在悬停时显示，触控和键盘用户可能无法获取":"Key rules shown only on hover may be unavailable to touch and keyboard users.",列表项一:"List item one",列表项三:"List item three","列表项二（按下中）":"List item two (pressed)",删除项目:"Delete project","利润率 ⓘ":"Profit margin ⓘ","利润率：毛利润 \xf7 营收":"Profit margin: gross profit \xf7 revenue","原因应直接可见或能被键盘、触屏访问，不能只靠悬停":"The reason should be directly visible or accessible by keyboard and touch, not hover alone.","及时可感知；具体时长按输入方式和动效系统调整":"Make it perceptible promptly; tune the exact duration to the input method and motion system.","只提供拖拽，会让键盘用户和无法精确拖动的用户无法完成排序。":"Offering only drag-and-drop prevents keyboard users and people who cannot drag precisely from sorting.","唯一入口仅在悬停时显示，可发现性不足":"The only entry point appears on hover, making it hard to discover.","外观要说明不可用；原生 disabled 与 aria-disabled 的交互语义不同":"The appearance should show that it is unavailable; native disabled and aria-disabled have different interaction semantics.","密码（必填）":"Password (required)","对长期无权限入口直接隐藏，用户可能无法发现功能或申请方式":"Hiding an unavailable entry point permanently may keep people from discovering the feature or how to request access.","必填！不填无法提交":"Required! You cannot submit without it.",悬停:"Hover","想选中文字，结果把整行拖走了":"Tried to select text, but dragged the entire row instead.",拖拽手柄提示可从此处开始拖动:"The drag handle shows where dragging can begin.","拖拽过程中没有状态变化，用户无法确认是否抓取成功":"Without a state change while dragging, people cannot tell whether they grabbed it successfully.",按下:"Pressed",按下即反馈:"Immediate press feedback","按下是短暂状态，不能代替持续的选中状态":"Pressed is temporary; it cannot replace a persistent selected state.",按下状态:"Pressed state",按钮:"Button",按钮也能完成排序:"Buttons can also complete sorting.","控件看似可用却不响应操作，状态与行为不一致":"The control looks available but does not respond, so its state and behavior are inconsistent.",提交:"Submit","提交中…":"Submitting…",放到这里:"Drop here","放大 1.35 倍还旋转，太闹了":"Scaling to 1.35\xd7 and rotating is too busy.",整行都是拖拽热区:"The entire row is a drag target.",普通成员:"Member",注册:"Sign up","点下去毫无变化，用户怀疑没点上，于是又点了一次":"Nothing changes after the click, so people wonder whether it registered and click again.",焦点指示需与背景有足够对比并保持可见面积:"Focus indicators need enough contrast with the background and enough visible area.","移除默认描边而未提供替代样式，键盘用户无法识别焦点":"Removing the default outline without a replacement leaves keyboard users unable to identify focus.",立即购买:"Buy now",编辑:"Edit","缩放和位移过大，会干扰按下反馈":"Excessive scale and movement interfere with press feedback.",自定义复选框:"Custom checkbox","自己画的组件，焦点样式也要自己补":"If you build the component yourself, you also need to provide its focus style.","行悬停时，次要操作淡入显现":"Secondary actions fade in when the row is hovered.",补充解释交给悬停提示:"Put supplemental explanations in a hover tooltip.",触屏拖动可能与页面滚动手势冲突:"Touch dragging can conflict with page-scrolling gestures.",请先填写密码:"Please enter a password first.","请求没回来前禁用，防重复提交":"Disable it until the request returns to prevent duplicate submissions.",轻微缩放可以表现按下期间的状态变化:"A slight scale change can show the state change while pressed.","轻轻一浮，告诉你可以点进去":"A subtle lift signals that you can click into it.","还有必填没填，提交保持禁用":"A required field is still empty, so Submit remains disabled.","需求文档 v3":"Requirements doc v3",项目设置:"Project settings",颜色和阴影变化提示当前元素可以点击:"Changes in color and shadow indicate that the current element is clickable.","Framer Motion 可通过该配置启用弹簧模型":"This configuration enables Framer Motion’s spring model.","cubic-bezier 四个数，捏出任意曲线":"Four cubic-bezier values can shape any curve.","ease-in：起步缓，加速离开":"ease-in: starts slowly, then accelerates away.","ease-out：先快后慢，逐渐减速并停下":"ease-out: starts fast, then slows to a stop.","fade-in 配合轻微位移，可表达进入方向":"A fade-in with slight movement can show the direction of entry.","linear 保持匀速，不适合所有入场位移":"linear keeps a constant speed and does not suit every entrance movement.","opacity 与 transform 通常能避免布局变化":"opacity and transform usually avoid layout changes.","opacity: 0 了还占位，挡住下面的点击":"At opacity: 0 it still takes up space and blocks clicks underneath.","两端拉过头，回弹失控；要弹性该用弹簧":"Both ends overshoot and rebound out of control; use a spring when you need elasticity.","入场使用 ease-in，前段反馈可能显得迟缓":"Using ease-in for entrance can make the initial feedback feel sluggish.",入场较缓:"Slow entrance",全部状态:"All states","内容切换交叉淡化，不打断视线":"Content cross-fades between states without interrupting the eye.",减弱动态效果:"Reduce motion",刚度:"Stiffness","刚度影响响应速度，阻尼影响振荡衰减":"Stiffness affects response speed; damping affects how oscillation decays.",加载呼吸:"Loading pulse",卡片:"Card",反复回弹会延迟稳定状态并分散注意:"Repeated rebounds delay the stable state and distract attention.",取消:"Cancel","变色过渡过长，会让反馈显得迟缓":"An overly long color transition makes feedback feel slow.","多元素依次入场，用 delay 编排":"Stage multiple elements with delay so they enter in sequence.",应响应用户的减弱动态效果偏好:"Respect the user’s reduced-motion preference.",弹窗:"Dialog","弹窗 fade":"Dialog fade",悬停变色:"Hover color change","悬停时颜色渐变过去，不是跳变":"On hover, the color transitions instead of jumping.","所有元素同时回弹，会削弱层级与重点":"When every element rebounds at once, hierarchy and emphasis weaken.","所有变化都只用 fade，会削弱层级与方向线索":"Using only fades for every change weakens hierarchy and directional cues.","把动作拆成关键帧，浏览器补齐中间":"Break the motion into keyframes and let the browser fill in between.","拖拽松手，弹性回原位":"Release after dragging and it springs back into place.","按动作类型复用少量曲线，兼顾一致性与场景差异":"Reuse a small set of curves by motion type to balance consistency with context.",按距离测试:"Test by distance","旧的淡出，新的淡入":"The old fades out; the new fades in.","时长由距离、任务和减少动态效果偏好决定":"Duration depends on distance, task, and reduced-motion preferences.",时长过长:"Duration too long","明确属性、时长和缓动曲线":"Specify the properties, duration, and easing curve.","未设置 fill-mode: forwards，结束后回到初始帧":"Without fill-mode: forwards, it returns to the initial frame when finished.","未设置 transition，颜色直接切换":"Without a transition, the color switches immediately.","松手 ↩":"Release ↩","每个动画随意定义曲线，会削弱系统一致性":"Giving every animation an arbitrary curve weakens system consistency.",淡入过慢会延迟内容可用感:"A fade-in that is too slow delays the sense that content is ready.","滑页 fade":"Slide fade","状态切换 vs 自主播放，各司其职":"State transitions vs. autonomous playback: each has its own job.",短反馈:"Brief feedback",确认:"Confirm","确认转账 \xa550,000？":"Confirm transfer of \xa550,000?","简单 hover 可使用 transition":"Simple hover effects can use transition.","缩放 fade":"Scale fade","菜单只原地淡入，缺少来源与方向线索":"The menu only fades in place, with no origin or directional cue.",轻微过冲可用于需要活力的低风险入场:"A slight overshoot can add energy to low-risk entrances.",较大位移:"Larger movement",过多循环动画会分散注意力:"Too many looping animations distract attention.","过渡 width/height 会触发重排，卡":"Transitioning width or height triggers reflow and can be janky.",这两个属性通常能避免触发布局变化:"These two properties usually avoid triggering layout changes.",进入与离开的节奏可按任务分别调整:"Tune the rhythm of entering and leaving separately for the task.",进行中:"In progress","连 width、padding 的意外变化也被动画":"Even unintended width and padding changes are animated.",退场较快:"Quick exit",阻尼:"Damping",阻尼过小会让振荡持续过久:"Too little damping lets oscillation last too long.","高风险确认需要稳定、清楚的反馈，明显回弹可能干扰判断":"High-risk confirmations need steady, clear feedback; obvious rebounds can interfere with judgment.",'"文本"':'"text"',"# 后面的内容不会发给服务器":"Content after # is not sent to the server.","// 注释":"// comment","/search?q=我的 页面":"/search?q=my page",': "小林" }':': "Xiaolin" }',": '小林' }":": 'Xiaolin' }","?q=按钮&sort=hot":"?q=button&sort=hot","A 记录把名称指向 IPv4 地址":"An A record points a name to an IPv4 address.","CDN 可缓存并分发静态资源":"A CDN can cache and distribute static assets.","CNAME 把一个名称指向另一个域名":"A CNAME points one name to another domain.","DNS 将域名解析到托管服务，托管服务再返回已部署的网页":"DNS resolves the domain to the hosting service, which then returns the deployed site.","GET 请求体没有通用语义，不应依赖服务端怎样处理它":"A GET request body has no universal meaning; do not depend on how a server handles it.","JSON 不允许最后一项后保留尾随逗号":"JSON does not allow a trailing comma after the last item.","JSON 不支持注释":"JSON does not support comments.","JSON 的键和字符串必须使用双引号":"JSON keys and strings must use double quotes.","Purge 后节点重新回源取新文件":"After a purge, edge nodes fetch the new file from origin.","logo.png 更新了":"logo.png updated",'{ "city": "深圳", "temp": 31 }':'{ "city": "Shenzhen", "temp": 31 }',"⚠ 您的连接不是私密连接":"⚠ Your connection is not private",不安全:"Not secure",仍按成功数据处理:"Still handled as successful data","仍然继续前往（不安全）":"Continue anyway (unsafe)","仍需部署网页并用 DNS 连接托管服务；否则可能看到 DNS 错误或注册商停放页，而不是自己的页面":"You still need to deploy the site and connect DNS to hosting. Otherwise, you may see a DNS error or a registrar parking page instead of your own site.","先确认整体结构，再按层级读取字段":"Confirm the overall structure first, then read fields by level.",刷新缓存:"Refresh cache","前端代码可见，密钥会泄露":"Frontend code is visible, so the secret will leak.","加密连接，并校验证书是否匹配当前域名":"Encrypts the connection and verifies that the certificate matches the current domain.",博客:"Blog",又改回:"Changed back","只复制了域名，对方打开是首页":"Only the domain was copied, so the recipient opens the home page.",可注册:"Available","同一名称的 CNAME 通常不能与 A 记录并存":"A CNAME for the same name generally cannot coexist with an A record.","名称过长且结构复杂，会增加输入和口头传达错误":"An overly long, complex name increases typing and verbal-communication errors.",地址填写错误会让请求到达错误服务或无法访问:"An incorrect address can send requests to the wrong service or make the site unreachable.","地址栏回车就是 GET":"Pressing Enter in the address bar is a GET.",多次变更:"Multiple changes","宽限、赎回、删除窗口和费用由注册局与注册商规则决定；删除后可能被他人注册":"Grace, redemption, deletion windows, and fees follow registry and registrar rules; after deletion, someone else may register it.",密码在加密通道里传输:"The password travels through an encrypted channel.",密码进了浏览器历史和服务器日志:"The password entered browser history and server logs.","密钥型 Key 放服务端；可公开 Key 也要按服务商限制配置":"Keep secret keys on the server; even public keys must follow the provider’s restrictions.",嵌套字段需要按层级读取:"Nested fields must be read by level.","已购入 vibeui.dev":"vibeui.dev purchased",已过期:"Expired","常见约定是读 / 提交或创建 / 替换 / 删除；以接口契约为准":"Common conventions are read / submit or create / replace / delete; follow the API contract.",应用:"App","强制 HTTPS":"Force HTTPS",成功:"Success",托管服务:"Hosting service",搜索:"Search","改成 A":"Changed to A","旧记录可能被缓存较久，变更后的收敛时间也会更长":"Old records may remain cached for a long time, so changes also take longer to converge.","最长缓存 1 天":"Max cache: 1 day","有序 JSON 值列表；是否同构要看接口约定":"An ordered list of JSON values; whether they share a shape depends on the API contract.",服务端错误:"Server error","未检查实际请求，就按假设修改接口格式":"Changing the API format based on assumptions without checking the actual request.",柏林用户:"Berlin user",查询参数随链接保存筛选或页面状态:"Query parameters preserve filters or page state in a link.",格式化:"Format","格式化会加入缩进，便于检查层级":"Formatting adds indentation, making the hierarchy easier to inspect.","法兰克福 \xb7 22ms":"Frankfurt \xb7 22ms","浏览器会提示连接未加密，用户无法确认传输是否受保护":"The browser warns that the connection is unencrypted, so users cannot verify that data is protected.","浏览器会显示证书警告，并可能阻止用户继续访问":"The browser displays a certificate warning and may stop users from proceeding.",深圳用户:"Shenzhen user","混合内容，被浏览器拦下":"Mixed content, blocked by the browser",片段标识可定位到页面中的指定位置:"A fragment identifier can jump to a specific place on the page.","用户与源站距离较远时，资源传输延迟会增加":"When users are far from the origin, asset-transfer latency increases.",登录:"Sign in","直连源站 \xb7 380ms":"Direct to origin \xb7 380ms","短 \xb7 好念":"Short \xb7 easy to say","空格等字符需要按 URL 规则编码":"Spaces and other characters must be encoded according to URL rules.",绕口:"Hard to say","缓存 1 小时":"Cached for 1 hour","缓存 1 年":"Cached for 1 year","缓存 30 天":"Cached for 30 days","缓存上限 10 分钟":"Max cache: 10 min","缓存尚未到期时反复改动，会让排查难以对应到单一配置":"Repeated changes before the cache expires make it hard to trace issues to one configuration.","缓存期过长且没有更新策略时，用户可能继续看到旧版本":"With an overly long cache period and no update strategy, users may keep seeing an old version.","缺少版本化或刷新策略时，用户可能继续看到旧资源":"Without versioning or a refresh strategy, users may keep seeing old assets.",缺少用户能够理解和执行的说明:"Missing instructions that users can understand and act on.","证书已过期 14 天":"Certificate expired 14 days ago","证书平台自动签发（Let's Encrypt）":"Certificate issued automatically by the platform (Let’s Encrypt)",账户余额等私有动态数据需要严格的缓存策略与鉴权隔离:"Private dynamic data such as account balances needs strict caching rules and authorization isolation.",资源不存在:"Resource not found",路径定位站点中的资源或页面:"A path locates a resource or page within a site.","返回是 JSON，先看清结构再取":"The response is JSON; inspect its structure before reading from it.","部署成功，已分发至全球节点":"Deployment successful; distributed to global edge locations.","重复请求可能创建多笔订单；服务端也要用幂等键或唯一约束兜底":"Repeated requests can create multiple orders; the server also needs idempotency keys or unique constraints as a safeguard.","链接可能进入历史、日志和转发记录，不应包含密钥":"Links can end up in history, logs, and forwarding records, so they must not contain secrets.","键名缺少双引号，无法按 JSON 解析":"The key lacks double quotes, so it cannot be parsed as JSON.","需同时评估续费价格、受众熟悉度、平台限制和后缀声誉":"Also evaluate renewal price, audience familiarity, platform restrictions, and the extension’s reputation.","页面 https，资源也都要 https":"If the page is HTTPS, every asset should be HTTPS too.","频繁重复请求，触发限流":"Frequent repeated requests trigger rate limiting.",首年低价:"Low first-year price","香港节点 \xb7 18ms":"Hong Kong edge \xb7 18ms","模块间距按层级、密度和相邻内容关系设定":"Set spacing between modules based on hierarchy, density, and their relationship to nearby content.","margin: 0 auto，定宽块自动居中":"margin: 0 auto centers a fixed-width block.","统一用 margin-bottom，间距只朝一个方向":"Use margin-bottom uniformly, and the spacing is only in one direction.",收藏:"Save","先检查行高和对齐规则；确有光学偏差时再局部微调":"Check line height and alignment rules first; only make local adjustments for a genuine optical misalignment.","块 A \xb7 margin-bottom: 20":"Block A \xb7 margin-bottom: 20","↕ 合并成 20（不是 32）":"↕ Combined into 20 (not 32)","块 B \xb7 margin-top: 12":"Block B \xb7 margin-top: 12","margin ↔ 拉开外部距离":"margin ↔ adds space outside","padding ↔ 增加内部留白":"padding ↔ adds space inside",内容:"Content","负 margin 让元素与前一部分重叠":"A negative margin makes an element overlap the section before it.","仅用于制造间距的空 div":"An empty div used only to create spacing",过小:"Too small",合适:"Appropriate","padding 会影响按钮尺寸和可点击区域":"Padding affects a button’s size and hit area.",间距过小:"Spacing is too small",保留内边距:"Keep padding","容器四边统一 padding，内容不顶边":"Use consistent padding on all four sides so content does not touch the edges.","内边距过小，内容紧贴容器边界":"The padding is too small and the content is close to the container boundary.",第一行:"First line",第二行:"Second line","段落行距应使用 line-height，而不是逐行增加 padding":"Paragraph spacing should use line-height instead of increasing padding line by line.","padding 过大，内容可用空间不足":"The padding is too large and there is insufficient space available for the content.","输入控件：control token":"Input control: control token","内容容器：surface token":"Content container: surface token","正方形 + 50% = 正圆头像":"Square + 50% = perfect circle avatar",胶囊标签:"Pill label",胶囊按钮:"Pill button",小档:"Small",中档:"Mid-range",大档:"Large","多个无语义档位混用，组件关系不一致":"Mixing several unlabeled sizes makes component relationships inconsistent.","长方形 + 50% = 椭圆，不是胶囊":"A rectangle + 50% = an oval, not a pill.","容器有圆角，但子内容仍超出圆角边界":"The container has rounded corners, but its child content still spills past them.","各角半径没有明确规则，组件外观难以保持一致":"Without clear rules for corner radii, components are hard to keep visually consistent.",悬停时用轻微阴影增强可操作反馈:"Use a subtle shadow on hover to reinforce that the element is interactive.",浮层可用更明显的阴影区分前后层级:"A floating layer can use a stronger shadow to distinguish it from the surface behind it.",内阴影可以表现向内凹陷的表面:"Inset shadows can make a surface appear recessed.","阴影过深过重，层级显得突兀":"Overly dark, heavy shadows make layers feel abrupt.","所有元素使用同等阴影，会失去层级区分":"Using the same shadow on every element erases the hierarchy.","阴影方向不一致，层级关系不清晰":"Inconsistent shadow directions make the layer relationships unclear.",正文加了投影:"Body text with a drop shadow",过重的文字阴影会降低字形清晰度:"Heavy text shadows reduce letterform clarity.",首页:"Home",组件:"Components",术语:"Term","display: flex 默认沿水平方向排列直接子元素":"By default, display: flex lays out direct children horizontally.",姓名:"Name",邮箱:"Email","flex-direction: column 改为垂直排列":"flex-direction: column changes the layout to vertical.","主轴与交叉轴都设为 center":"Set both the main and cross axes to center.",项目动态:"Project news",查看全部:"View all","space-between：标题靠左，操作靠右":"space-between: title on the left, action on the right",左浮动:"float left",右浮动:"float right",用于常规排列时还需额外清除浮动:"Using floats for ordinary layout also requires clearing them.","需要同时控制行列关系时，Grid 通常更直接":"Grid is usually more direct when you need to control rows and columns together.","固定宽度且禁止换行时，子元素可能溢出容器":"When the width is fixed and line wrapping is prohibited, child elements may overflow the container.",标签一:"Label one",标签二:"Label two",标签三:"Label three",标签四:"Tag four",标签五:"Tag five",标签六:"Tag six","未设置 flex-wrap，标签空间不足而压缩":"Without flex-wrap, labels shrink when there is not enough room.","三列等分：repeat(3, 1fr)":"Three equal columns: repeat(3, 1fr)","auto-fill 会按最小列宽在容器中创建可容纳的列":"auto-fill creates as many columns as fit at the minimum column width.","Grid 可直接定义侧栏与主要内容的列宽关系":"Grid can directly define the width relationship between a sidebar and the main content.","gap 统一管格距，不用逐个写 margin":"Use gap to control spacing consistently instead of setting margin on every item.","手写百分比栅格，调整间距时需要额外计算":"A hand-written percentage grid needs extra calculations whenever spacing changes.",固定列数与列宽可能在窄屏溢出:"Fixed column counts and widths can overflow on narrow screens.","逐项使用 margin 会增加边缘间距的单独处理":"Adding margins item by item means handling edge spacing separately.","导航 \xb7 z-index: 100":"Navigation \xb7 z-index: 100","在同一层叠规则里，让导航高于滚动内容":"Within the same stacking context, keep the navigation above scrolling content.","下拉浮在内容上，不被裁不被盖":"The dropdown sits above the content without being clipped or covered.","内容 1":"Content 1","吸顶 100":"Sticky header 100","浮层 1000":"Overlay 1000","弹窗 10000":"Dialog 10000","定几个固定档位，全项目统一用":"Define a few fixed size steps and use them consistently across the project.","z-index: 99 但没设 position":"z-index: 99, but no position is set","static 元素上 z-index 无效":"z-index has no effect on a static element","用更大数值覆盖问题，层级规则难以维护":"Using ever-larger values to cover problems makes layer rules hard to maintain.","父级 z-index: 1":"Parent z-index: 1","子级 9999":"Child 9999","子级再大，也翻不出父级的层级":"No child z-index can escape its parent’s stacking level.",代码中较早出现的内容:"Content that appears earlier in the code","用 z-index 强行改变遮盖顺序":"Use z-index to force a different stacking order","若视觉顺序应与文档顺序一致，应先调整 DOM 结构":"If the visual order should match the document order, adjust the DOM structure first.",可用:"Available",禁用:"Disabled","禁用态：opacity 降到 0.4 左右":"Disabled state: opacity drops to about 0.4","次要图标淡一点，悬停恢复 1":"Dim secondary icons slightly; restore full opacity on hover.","遮罩半透明，页面还隐约可见":"The overlay is translucent, so the page remains faintly visible.","配合 transition，淡入淡出最常用":"With transition, fades are the most common effect.","左边连文字一起淡，右边只淡背景":"On the left, the text fades too; on the right, only the background fades.","正文透明度过低，文字对比度不足。":"Body text is too transparent, so its contrast is too low.","这里有个 opacity: 0 的按钮，还点得到":"This opacity: 0 button is still clickable.","多层透明度会叠加，实际颜色更难预测":"Opacity compounds across layers, making the resulting color harder to predict.","把想法变成网页，只需一句话":"Turn an idea into a web page with one sentence.",免费开始:"Start for free","一句话价值 + 一句补充 + 一个主按钮":"One value statement + one supporting line + one primary button",一句话标题:"One-sentence headline","主视觉帮用户「看见」产品长什么样":"The main visual helps users “see” what the product looks like.","内容说明了价值，但没有提供明确的下一步":"The content explains the value but gives no clear next step.","赋能 \xb7 连接 \xb7 重构未来":"Empower \xb7 Connect \xb7 Reimagine","没有说明产品用途、适用对象或下一步":"It does not say what the product is for, who it is for, or what to do next.","信息量过大，核心价值不容易扫描":"There is too much information to scan the core value easily.",开始免费试用:"Start your free trial","试用期限 \xb7 是否需要信用卡 \xb7 取消规则":"Trial length \xb7 Whether a card is required \xb7 Cancellation policy",在行动入口旁说明影响决定的条件:"State decision-making conditions next to the call to action.",开始使用:"Get started",长页顶部和结尾各放一次:"Place one at the top and another at the end of a long page.","主要行动仅以低强调的小链接出现，难以识别":"The primary action appears only as a low-emphasis text link, so it is hard to spot.","仅剩 3 个名额！":"Only 3 spots left!",马上抢购:"Buy now",名额提示没有对应的真实库存或截止规则:"The availability message is not backed by real inventory or a deadline rule.",例:"example",已授权原话:"Authorized original words","来源类型 \xb7 取得方式 \xb7 授权状态":"Source type \xb7 How it was obtained \xb7 Permission status","身份可以匿名，但来源和授权不能省略":"The person may remain anonymous, but the source and permission details must not be omitted.","「在新手引导任务中，完成时间从原来的范围缩短到新的范围。」":'"In the onboarding task, completion time dropped from the previous range to the new range."',"来源类型 \xb7 授权状态 \xb7 统计口径":"Source type \xb7 Permission status \xb7 Measurement methodology",具体场景和可复核结果比泛泛称赞更有参考价值:"Specific scenarios and verifiable results are more valuable than general praise.",平均分:"Average rating","样本量 \xb7 来源平台 \xb7 统计时间":"Sample size \xb7 Source platform \xb7 Date measured","缺少任一口径时，不展示具体评分":"Do not show a specific rating if any measurement detail is missing.",已授权头像:"Authorized avatar","人数口径 \xb7 展示范围 \xb7 授权记录":"Counting method \xb7 Display scope \xb7 Permission record","头像只能代表有依据的人，不能暗示虚构规模":"The avatar can represent only a documented person; it must not imply a made-up scale.","「非常好用」「很推荐」":'"Very easy to use" "Highly recommended"',"没有场景或结果，读者无法判断评价依据":"Without a scenario or outcome, readers cannot assess what supports the claim.","匿名反馈 \xb7 来源类型与取得方式":"Anonymous feedback \xb7 Source type and how it was obtained","匿名并不等于无效，但仍需保留可核验信息":"Anonymous does not mean invalid, but the supporting details must still be verifiable.","「这款产品彻底改变了我的生活！」—— 身份不明":'"This product changed my life!" — Unidentified source',"无法核对来源、授权和使用背景":"The source, permission, and context of use cannot be verified.","◆ 品牌":"◆ Brand",产品:"Product",定价:"Pricing","搜索 \xb7 登录":"Search \xb7 Sign in","品牌、导航和辅助操作共同组成页头":"Branding, navigation, and supporting actions together make up the page header.",文档中心:"Documentation","⌕ 搜索文档":"⌕ Search documents",搜索和账号入口也可以放在页头:"Search and account controls can also go in the page header.","窄屏保留品牌，把次要入口收进菜单":"On narrow screens, keep the brand visible and move secondary links into a menu.","新版本已发布 \xb7 查看更新":"New version released \xb7 Check for updates","产品　文档　登录":"Product Documentation Login","公告条属于页头，但不是导航栏本身":"The announcement bar is part of the page header, not the navigation bar itself.","品牌　产品　方案　客户　价格　文档　博客　活动　招聘　搜索　登录　注册":"Brand \xb7 Product \xb7 Solutions \xb7 Customers \xb7 Pricing \xb7 Docs \xb7 Blog \xb7 Events \xb7 Careers \xb7 Search \xb7 Sign in \xb7 Sign up","入口全部挤在顶部，用户很难找到重点":"When every link is crowded into the top bar, users struggle to find what matters.",固定页头占据近半屏:"The fixed header takes up nearly half the screen.",页头过高会持续挤压正文空间:"An overly tall header continually reduces the space for body content.",价格:"Pricing",帮助:"Help","没有品牌或首页入口，用户难以确认自己在哪个网站":"Without a brand or home link, users may not know which site they are on.",文档:"Docs","Header 描述顶部容器，Navbar 描述导航职责；两者可能视觉重合":"Header names the top-level container; Navbar names the navigation function. They may overlap visually.","品牌 + 入口 + 主操作，三段式":"Brand + navigation + primary action: a three-part header","导航栏 \xb7 吸顶":"Navigation bar \xb7 Sticky",长页面中保留需要频繁使用的导航入口:"Keep frequently used navigation available on long pages.","桌面空间充足时仍隐藏全部主要入口，会增加访问步骤":"Hiding every main link even when desktop space is available adds unnecessary steps.","没有高亮，我现在在哪一页？":"Nothing is highlighted—what page am I on?",功能:"Features",支持:"Support",联系:"Contact","链接按用途分组，末尾保留版权信息":"Group links by purpose and keep the copyright notice at the end.",让人找得到你:"Make it easy to find you","关于我们 加入我们 新闻中心 投资者关系 合作伙伴 开发者 开放平台 API 文档 帮助中心 社区 博客 活动 招聘 公益 隐私 条款 网站地图":"About Us Join Us News Center Investor Relations Partners Developers Open Platform API Documentation Help Center Community Blog Events Recruitment Charity Privacy Terms Site Map","链接过多且没有分组，扫描和查找成本都会增加":"Too many links and no grouping increases scanning and lookup costs.","\xa9 起始年份–当前年份 权利主体":"\xa9 Starting year – current year Rights owner","版权信息应准确；维护状态应另行标注更新时间":"Keep copyright information accurate; show maintenance status with a separate update date.","\xa9 2026 某公司":"\xa9 2026 Example Company","需要用户咨询或反馈的页面，还应提供合适的联系入口":"Pages that invite questions or feedback should also provide an appropriate contact option.","最好用的建站工具 免费建站 网站模板 网页设计 在线建站 SEO 优化 企业官网 快速建站……":"The best website building tools, free website building, website templates, web design, online website building, SEO optimization, corporate official website, quick website building...",给搜索引擎看的关键词堆砌:"Keyword stuffing meant for search engines","免费版够用吗？":"Is the free version enough?",从真实客服记录里挑问题:"Pick questions from real customer service records","如何取消订阅？":"How to cancel your subscription?","先给结论，再说明入口、生效时间和费用处理。":"Give the answer first, then explain where to do it, when it takes effect, and how fees are handled.","第一句回答问题，后面补充必要条件":"Answer the question in the first sentence and add necessary conditions later.","为什么我们是行业第一？":"Why are we number one in the industry?","自问自答的软文，不是 FAQ":"Promotional copy posing as questions and answers—not a real FAQ","如何退款？":"How to get a refund?","答案过长时，应先给结论并分段突出条件":"When an answer is long, lead with the conclusion and separate the conditions into clear sections.",问题一:"Question one",问题二:"Question 2",问题三:"Question three","问题很多时全部展开，会增加浏览和检索成本":"When there are many questions, expanding them all will increase browsing and retrieval costs.",价格与计费规则:"Pricing and billing","关键信息只出现在 FAQ 后部，主要决策位置没有说明":"Key information only appears at the end of the FAQ, and the main decision-making locations are not explained.",入门:"Getting started",示例价格:"Sample price",协作:"Collaboration",组织:"Organization",联系报价:"Contact us for pricing","示例结构：按真实用户分层决定档位数量":"Example structure: choose the number of tiers based on real user segments.",推荐方案:"Recommended plan","只在有使用数据或明确适用条件时标注，并说明依据":"Only mark it when there is usage data or clear applicable conditions, and explain the basis.",月付价格:"Monthly price",年付总价:"Annual total","同时列出周期、总价与取消规则，不用折扣制造压力":"Show the billing period, total price, and cancellation policy together; do not use discounts to create pressure.",开始免费版:"Start with the free plan",升级专业版:"Upgrade to Pro","可购买方案各有清楚下一步；也可联系销售或标记当前方案":"Each plan should have a clear next step; alternatives include contacting sales or marking the current plan.","相似档位过多，比较成本会明显增加":"Too many similar tiers make comparison much harder.",联系销售获取报价:"Contact sales to get a quote","标准化个人方案通常应直接说明价格；复杂企业方案可以询价":"Standard personal plans should usually show their price directly; complex enterprise plans can be quoted on request.","加购专属客服 \xa530/月":"Add dedicated support for \xa530/month","立即支付 \xa579":"Pay now \xa579",预先勾选付费项会改变用户原本选择的总价:"Preselecting paid options changes the total the user originally chose.","\xa59.9/月":"\xa59.9/month","* 仅限首月，次月恢复 \xa599，需承诺在网 24 个月":"* \xa59.9 applies to the first month only. The price is \xa599/month afterward, with a 24-month service commitment.",续费价格和期限不应只放在难以注意的位置:"Do not hide the renewal price or commitment term where people are unlikely to notice them.","示例占位 \xb7 仅展示已授权标识":"Sample placeholder \xb7 Only displays authorized logos",客户标识:"Customer logo","客户 A":"Customer A","客户 B":"Customer B","客户 C":"Customer C","遵守品牌标识规范，并统一尺寸、间距和视觉权重":"Follow brand guidelines and keep logo size, spacing, and visual weight consistent.",用户量:"User count",统计口径:"Measurement methodology",评分:"Rating",来源平台:"Source platform",可用率:"Availability",时间范围:"Time period","每个数字都要附来源、时间和计算口径":"Give every number a source, timeframe, and measurement methodology.","平台 \xb7 样本量 \xb7 抓取时间":"Platform \xb7 Sample size \xb7 Date collected",授权头像:"Authorized avatar","人数口径 \xb7 展示范围":"Counting method \xb7 Display scope","「改变世界的工具」—— 某知名媒体":'"A tool that changes the world" — Unnamed major publication',查不到出处的引述:"An unattributed quote",某项用户数量:"A product’s user count",是否展示取决于统计口径和对目标用户的参考价值:"Show it only when the measurement is well defined and useful to the intended audience","\uD83C\uDFC6 2018 年度最佳应用":"\uD83C\uDFC6 Best App of 2018",八年前的奖项还在墙上:"An eight-year-old award is still on display.","标识颜色、尺寸和间距缺少统一规则，会干扰正文重点":"Without consistent rules for logo color, size, and spacing, logos compete with the main content.",皮革:"Leather",亚麻:"Linen",金属:"Metal",界面借用现实材质线索:"The interface borrows cues from real-world materials.",完成:"Finish","顶部一条高光 + 底部一块投影 = 凸出来":"Top highlight + bottom shadow = raised surface",按我:"Press me",现实隐喻可帮助用户理解可操作区域:"Real-world metaphors can help people recognize interactive areas.",亚麻布纹打底:"Linen texture background","大面积空白用细腻纹理填满，空而不寡":"A subtle texture can give a large empty area warmth without making it feel crowded.",多种材质会增加视觉与资源复杂度:"Using many materials increases both visual and asset complexity.",教长辈用平板:"Teaching older adults to use a tablet",点这里发语音:"Click here to send a voice message",日记本:"Diary","复古手账应用，材质支持主题表达":"A retro journaling app can use material cues to support its theme.",木:"Wood",弦:"Strings","相机、录音、合成器的拟真面板":"Realistic control panels for cameras, recorders, and synthesizers","现代浅色界面里，局部一条皮革当点缀":"A strip of leather adds a small accent to an otherwise modern light interface.",正文落在纹理上:"Body text sits on a textured background",纹理会干扰正文阅读:"The texture interferes with reading body text.",一个界面使用多张材质图:"One interface uses multiple material images",资源需评估:"Assess asset costs",过多位图会增加加载与适配成本:"Too many bitmap images increase loading and responsive-design costs.",报表中心:"Report Center",材质与任务不匹配:"The material treatment does not fit the task.",效率工具应优先保证数据与操作清楚:"Efficiency tools should prioritize clear data and controls.","整站使用前，先验证材质是否支持内容与任务":"Before using a material treatment across the site, verify that it supports the content and task.",邮件:"Email",照片:"Photos",日历:"Calendar","靠颜色分区，不靠边框和阴影":"Use color, not borders or shadows, to separate sections.",拟物:"Skeuomorphic",扁平:"Flat","删掉阴影、渐变、纹理，只剩颜色":"Remove shadows, gradients, and textures, leaving color alone.",图标可简化为易辨认的几何形:"Icons can be simplified into recognizable geometric shapes.",排版就是导航:"Typography guides navigation","超大细字 + 大量留白，层级靠字重":"Oversized thin type + generous whitespace; hierarchy comes from weight.",桌面宽:"Desktop",手机:"Mobile","色块易于缩放，性能仍取决于完整页面资源":"Color blocks scale easily, but performance still depends on the page’s full asset load.",标题:"title","按钮？":"Button?","全平之后分不清哪里能点 → Flat 2.0 加回轻阴影":"When everything is flat, it is hard to tell what is clickable → Flat 2.0 brings back subtle shadows",订单示例:"Order example",转化示例:"Conversion example",告警示例:"Alarm example",小屏与弱网场景可优先使用简化图形:"Use simplified graphics first on small screens and slower connections.",品牌色:"Brand color",有职责的品牌色可帮助分区和识别:"Purposeful use of brand color can support grouping and recognition.","先用「纯色块 + 大留白」":"Start with solid color blocks and generous whitespace.",验证结构:"Verify structure",欢迎回来:"Welcome back","查看详情　提交订单　退出":"View details \xb7 Submit order \xb7 Sign out",文字与操作入口难以区分:"Text and interactive controls are hard to tell apart.",导航:"Navigation",相同处理会削弱信息层级:"Treating everything the same weakens the information hierarchy.","弹窗和卡片叠一起，分不清前后":"The dialog and cards overlap, making it hard to tell which is in front.","大面积留白 + 一行小字":"A large blank area + one line of small text",留白未形成明确的阅读层级:"The whitespace does not create a clear reading hierarchy.",内容层:"Content layer",浮起:"Lifted",浮层:"Floating layer","阴影是层级线索，强度按表面关系调整":"Shadows signal hierarchy; adjust their strength to match the relationship between surfaces.","涟漪从指尖荡开：告诉用户「按到了」":"A ripple spreads from the tap point to show that the press registered.","需要快速发起主任务时，可使用悬浮按钮":"Use a floating action button when people need to start the main task quickly.",主色定调:"Primary color sets the tone",强调色点缀:"Accent color draws attention",新建:"New","新页面从点按处生长出来，动效解释来龙去脉":"The new page expands from the tap point, so the motion explains where it came from.","可参考 Android 平台的组件与交互规范":"Refer to Android’s component and interaction guidelines.",浮动标签可明确字段名称与输入状态:"Floating labels can clarify field names and input states.","Material You 可基于壁纸生成配色":"Material You can generate a color scheme from a wallpaper.",过多阴影层级会干扰界面关系:"Too many shadow levels obscure interface relationships.",链接:"Link",强调色过多会削弱主操作与状态的区分:"Too many accent colors will weaken the distinction between main operations and states.",多个悬浮主操作会使优先级不清楚:"Multiple floating primary actions make priorities unclear.",紫色按钮:"Purple button",玫红按钮:"Hot-pink button",只采用配色而未建立组件与状态规则:"It uses the color palette without establishing rules for components and states.",白色柔光和灰蓝暗影共同表现凸起:"Soft white highlights and blue-gray shadows make the surface appear raised.",背景:"Background",相近色会减弱组件之间的边界:"Similar colors weaken the boundary between components.",可按:"Pressable",已按:"Pressed",凸起和凹下辅助表达不同状态:"Raised and recessed surfaces help communicate different states.",大圆角和柔和阴影形成软质感:"Large corner radii and soft shadows create a plush feel.",看清我了吗:"Do you see me clearly?",低对比度会降低文字和控件识别性:"Low contrast reduces the legibility of text and controls","适合重氛围、操作较少的局部界面":"Best for small, atmospheric interfaces with few actions.",概念稿可以先验证材质方向和可读性:"Use a concept mockup to test the material direction and readability first.",在常规界面中将新拟态限制在非关键区域:"In everyday interfaces, limit neumorphism to noncritical areas.","时钟、天气等以展示为主的界面":"Display-focused interfaces such as clocks and weather.","灰色正文和相近背景会降低长文可读性。":"Gray text and similar backgrounds reduce the readability of long text.","姓名？":"Name?",输入框与背景边界不清楚:"The boundary between the input box and the background is unclear",关键按钮缺少清楚的可点击状态:"Key buttons lack clear clickable status",阳光下:"In sunlight",低对比度在明亮环境中更难识别:"Low contrast is even harder to see in bright environments.","银灰渐变是金属字示例，适合短标题":"A silver-gray gradient is one metallic-type treatment, best kept to short headlines.",泡泡糖粉:"Bubblegum pink",冰蓝:"Ice blue","粉与冰蓝是年代配色示例，也可使用其他组合":"Pink and ice blue are one period-inspired palette; other combinations can work too.",圆角示例:"Rounded-corner example",方角示例:"Square corner example","圆润轮廓常见，但边角应按品牌和组件选择":"Rounded shapes are common, but choose corner treatments to suit the brand and component.",局部白色高光可提示透明塑料材质:"Partial white highlights can indicate transparent plastic materials","星形装饰可置于边角，避免干扰内容":"Star decorations can be placed in the corners to avoid distracting from the content","♡ 甜心潮牌 \xb7 千禧复刻系列上新":"♡ Sweetheart Streetwear \xb7 Y2K Reissue Drop",适合品牌需要复古数码与玩乐感时:"Works when a brand needs a retro-digital, playful feel.","♪ 偶像应援站 \xb7 新单应援色冰蓝":"♪ Fan Hub \xb7 New Single Support Color: Ice Blue","播放器皮肤、应援页都适合":"Works for both player skins and fan-support pages.","✦ 欢迎来到我的主页 ✦ 留言板 \xb7 相册 \xb7 背景音乐":"✦ Welcome to my homepage ✦ Message board \xb7 Photo album \xb7 Background music",个人主页可用它表达兴趣和身份:"A personal homepage can use it to express interests and identity.","联名限定 \xb7 复古千禧快闪店,只开 7 天":"Limited collab \xb7 Retro Y2K pop-up, open for 7 days only",短周期活动页可使用更鲜明的主题表达:"Short-term campaign pages can use a more distinctive visual theme.","\uD83C\uDFE6 公积金查询页使用粉色泡泡和闪片":"\uD83C\uDFE6 The provident fund inquiry page uses pink bubbles and glitter","政务与金融页面应优先建立清楚、可信的表达":"Government and financial pages should prioritize clarity and trustworthiness.","正文整段做成金属渐变,反光晃眼看不清":"The entire text section is made into a metallic gradient, which is hard to see due to glare.",金属渐变通常只用于短标题或装饰文字:"Metallic gradients are usually only used for short titles or decorative text",整页高饱和渐变:"Full page high saturation gradient",高饱和画面应保留阅读和操作所需的安静区域:"Highly saturated visuals need quieter areas for reading and interaction.",极简商务:"Minimalist business","Y2K 泡泡":"Y2K Bubble",混用前先确定主视觉语言与辅助元素:"Determine the main visual language and auxiliary elements before mixing them","波点 / 三角 / 波浪线":"Polka dots / triangles / wavy lines",高饱和撞色示例:"Example of highly saturated contrasting colors","颜色需分主次，并保证文字与状态可辨认":"Give colors clear priorities, and keep text and states distinguishable.",深色描边:"dark stroke",无描边:"No stroke","描边可分离小元素，粗细按尺寸和主题调整":"Outlines can separate small elements; adjust their weight for the size and theme.",内容区保持清楚:"Keep content areas clear",留白可为装饰与内容保留清楚关系:"Whitespace keeps the relationship between decoration and content clear.","品牌活动主视觉：撞色横幅 + 波点 + 之字线":"The main visual of the brand event: contrasting banners + polka dots + zigzag lines",运营活动页可使用孟菲斯的节奏感:"Campaign pages can use Memphis design’s sense of rhythm.","\uD83E\uDDD2 儿童英语应用：每节课使用一个几何角色":"\uD83E\uDDD2 English app for kids: use a geometry character in each lesson",活泼的秩序感可支持课程内容与引导:"A lively sense of order supports course content and guidance","设计工作室招聘页:撞色块 + 散布小三角":"Design studio recruitment page: contrasting color blocks + scattered triangles","可表达创作方向，同时让职位与投递方式清楚":"It can express a creative direction while keeping open roles and application instructions clear.","空状态：波点圆、波浪线与「还没有内容」":'Empty state: polka dot circle, wavy line and "no content yet"',小面积装饰可为状态说明提供情绪支持:"Small areas of decoration can provide emotional support for status statements",后台系统多个页面持续使用撞色与散布装饰:"A back-office system uses contrasting colors and scattered decoration across many pages.",高频工具会因此降低扫描效率并增加视觉疲劳:"In a high-frequency tool, this reduces scanability and increases visual fatigue.",装饰覆盖正文会降低可读性:"Decoration that covers body copy reduces readability.","低饱和配色也可使用，但需与几何语言和内容语气协调":"A low-saturation palette can work too, as long as it fits the geometric language and content tone.","年报数据页、合同签署页使用撞色与散布装饰":"An annual-report data page or contract-signing flow uses contrasting colors and scattered decoration.",高风险或正式流程应优先保证信息与操作清楚:"High-risk or formal flows should prioritize clear information and actions.","iiii 与 mmmm 一样宽":"iiii is as wide as mmmm","等宽字体便于对齐命令、路径和数据":"Monospaced fonts make commands, paths, and data easier to align.",绿字黑底:"Green text on black",黑白单色:"Black-and-white monochrome",少量基础色有助于突出命令与状态:"A small basic palette helps distinguish commands and states.","提示符可标明命令上下文，仍需文字说明任务":"A prompt can show command context, but the task still needs clear text.","ASCII 字符可作轻量分隔线，并非图标替代品":"ASCII characters can serve as lightweight dividers; they are not substitutes for icons.","闪烁光标只作运行提示，并支持减少动效":"Use a blinking cursor only to show that something is running, and honor reduced-motion preferences.","CLI 工具官网可沿用命令行的内容线索":"A CLI tool’s site can borrow cues from the command line.","文档站用等宽字体,目录都像命令输出":"The docs site uses monospaced type, making every navigation item look like command output.","成功响应 \xb7 示例延迟":"Successful response \xb7 Sample delay","$ whoami → 后端工程师(远程)":"$ whoami → backend engineer (remote)","可表达工程文化，岗位与投递信息仍需直接":"It can express engineering culture, but job details and application instructions must stay direct.",家庭相册应用也使用黑底绿字:"The family photo album also uses green text on black.",非技术场景可能难以从该风格中获得任务线索:"In nontechnical contexts, this style may offer few useful task cues.","暗绿配黑底,字号再一缩,内容难以识别":"Dark green on black, made even smaller, becomes hard to read.","需同时检查字号、行高和颜色对比":"Check font size, line height, and color contrast together.","首屏放置终端截图，文字无法选择或搜索":"A terminal screenshot fills the first screen, leaving text unselectable and unsearchable.","命令应保留为可复制、可搜索的真实文字":"Keep commands as real text that people can copy and search.",毛玻璃气泡:"Frosted-glass bubbles","无关材质会模糊命令、状态和任务的关系":"Unrelated materials blur the relationship between commands, states, and tasks.","米白 / 灰褐 / 墨色":"Off-white/taupe/ink","这是自然材料配色示例，可按产品与摄影调整":"This natural-material palette is only an example; adapt it to the product and photography.","空 ✓":"Open ✓","挤 ✗":"Crowded ✗",余白之美:"The beauty of negative space","衬线与宽字距是示例，中文正文需优先易读":"Serifs and wide tracking are examples; prioritize legibility in Chinese body copy.",题字靠左:"Calligraphy on the left","位置是示例，重点是保持视觉平衡":"The position is only an example; maintaining visual balance is what matters.",纸面颗粒可补充材料感:"Paper grain can add to the material feel.","素色床品 \xb7 棉麻四件套":"Natural linen bedding \xb7 4-piece set",家居品牌官网可使用克制的材料与排版:"A home-goods brand site can use restrained materials and typography.","手作粗陶茶杯 \xb7 一只一窑":"Handmade stoneware cups \xb7 Fired one kiln at a time","茶 / 香 / 器物电商":"E-commerce for tea, incense, and tableware","山里的温泉旅馆 \xb7 房态以实际页面为准":"Mountain hot-spring inn \xb7 Check the booking page for live availability",民宿预订页可用安静的视觉节奏呈现空间:"A guesthouse booking page can use a quiet visual rhythm to present the space.","「秋日备忘录」\xb7 散文集":'"Autumn Memo" \xb7 Prose Collection',个人博客与长文阅读:"Personal blogs and long-form reading","数据大盘：多张图表 + 实时刷新 KPI":"Data dashboard: multiple charts + live KPI updates",任务密集场景应优先保证扫描效率:"In task-dense contexts, prioritize scanability.","高饱和色需要明确职责，避免打断安静层级":"Highly saturated colors need a clear purpose so they do not disrupt the quieter hierarchy.","只有一行字 + 纯白底,没有内容关系":"One line of text on a plain white background, with no relationship to the content","留白应帮助阅读或展示材料，而不是替代信息":"Whitespace should support reading or showcase material, not stand in for information.","限时 5 折":"50% off for a limited time",爆款:"Bestseller",新品:"New arrival",促销标签过多会打断阅读节奏:"Too many promotional tags interrupt the reading rhythm.","客户标识（需授权）":"Customer logo (permission required)",运行信息字段:"Operating-information field",可核验信息:"Verifiable details",范围:"Scope",服务区域:"Service area",口径:"Methodology",团队统计:"Team metric",时段:"Time period",支持说明:"Support details",商品信息字段:"Product-information field",产品名称:"Product name",价格字段:"Price field",评价信息字段:"Review-information field",评分来源:"Rating source","样本量 \xb7 时间 \xb7 平台":"Sample size \xb7 Date \xb7 Platform",服务状态字段:"Service-status field",链接监控来源:"Link-monitoring source",执行状态字段:"Execution-status field",产地与批次信息以实际页面为准:"See the product page for current origin and batch details.","右边留白更充分，分组和阅读节奏更清楚":"More space on the right makes the groups and reading rhythm clearer.",重点颜色:"Accent color","中性色为主，把强调色留给真正需要注意的地方":"Use mostly neutral colors and reserve accents for what truly needs attention.","8 / 16 / 24 / 32：一套可复用的间距示例，不是硬性公式":"8 / 16 / 24 / 32: a reusable spacing scale, not a fixed formula","字号、字重与分组共同建立阅读层级":"Font size, weight, and grouping work together to establish reading hierarchy.","左：轻量分层；右：阴影过重，内容被效果干扰":"Left: subtle layering. Right: heavy shadows distract from the content.",适合让产品信息和主要行动保持清楚:"Good for keeping product information and primary actions clear.","✓ 现代简约":"✓ Modern minimalism",复古:"Retro",赛博:"Cyberpunk","需求还不明确时，可先用它建立清楚、稳定的基础界面":"When requirements are still unclear, use it to establish a clear, stable base interface.",让排版突出主要内容:"Use layout to highlight the main content.","减少无关装饰，让内容层级更容易识别":"Remove irrelevant decoration so the content hierarchy is easier to read.",基础规则:"Basic rules",组件复用:"Component reuse",持续迭代:"Continuous iteration","规则少而一致，后续扩展和维护更容易":"Fewer, more consistent rules make future expansion and maintenance easier.","年货节…全场五折…（冷静版）":"Lunar New Year sale … 50% off sitewide … (restrained version)","活动页仍需足够的节奏、重点和品牌情绪":"A campaign page still needs rhythm, focal points, and brand emotion.",标题位置不一致:"Inconsistent headline placement","缺少对齐、网格和字重层级":"Missing alignment, grid structure, and type-weight hierarchy",简约仍需要清楚的结构与层级:"Simplicity still requires clear structure and hierarchy","主题色一多，克制感就没了":"Too many theme colors undermine the restrained feel.",面向儿童的活动页面:"A campaign page for children","应根据年龄、内容、可读性和品牌测试视觉语言，不能机械套用黑白极简":"Test the visual language against the audience’s age, content, readability, and brand; do not mechanically apply black-and-white minimalism.",一屏聚焦一个重点:"One focal point per screen",留白支持内容节奏:"Whitespace supports the content rhythm","重点数量由内容决定，避免同屏相互争抢":"Let the content determine how many focal points appear, so they do not compete on one screen.","连续圆角是常见手段，数值随组件尺寸调整":"Consistent corner radii are common; adjust the values for each component’s size.","毛玻璃：透得出颜色，看不清细节":"Frosted glass: color shows through, but details stay blurred","近处一层细、远处一层软，叠出纵深":"A crisp layer in front and a softer one behind create depth.","渐变可用于短重点，范围取决于信息层级":"Gradients can emphasize short content; their extent should match the information hierarchy.","全新的它，来了。":"The new one is here.","发布页：一句大字 + 一个产品":"Launch page: one big statement + one product","购买 >":"Buy >","高价格产品更需要清楚说明价值、规格和购买条件":"High-priced products need to clearly state the value, specifications and purchase conditions.",让视觉先说话:"Let the visuals speak first","高质量素材负责情绪，界面负责秩序":"High-quality imagery sets the mood; the interface provides order.",专注森林:"Forest Focus","★ 4.9 \xb7 效率类第 1 名":"★ 4.9 \xb7 1st place in efficiency category","App 详情页：图标、评分、获取按钮":"App detail page: icon, rating, and Get button","数据密集的后台，大留白是浪费":"In a data-dense back-office tool, excessive whitespace wastes useful space.",处处毛玻璃:"Frosted glass everywhere",材质过多会削弱层级并增加性能成本:"Too many materials weaken the hierarchy and increase performance costs","低清图片 + 不协调圆角 + 默认字体":"Low-resolution images + mismatched corner radii + default typography",素材与组件细节不一致会削弱整体品质:"Mismatched image and component details weaken the overall quality.","报销单审批（每字段间隔 80px）":"Expense-report approval (80px between each field)",表单工具应优先保证信息密度与填写效率:"Form tools should prioritize information density and completion efficiency.",页面即文档:"The page is the document","▏在此编辑内容":"▏Edit content here",编辑界面以内容本身为中心:"The editing interface centers the content itself.","\uD83D\uDE80 发布计划":"\uD83D\uDE80 Release plan","\uD83C\uDF5C 食谱":"\uD83C\uDF5C Recipes","\uD83D\uDCDA 读书笔记":"\uD83D\uDCDA Reading notes","emoji 可作轻量分类，关键功能仍需稳定名称":"Emoji can provide light categorization, but key functions still need stable labels.",一个内容块:"A content block","次要操作可按需出现，并支持聚焦与触屏入口":"Secondary actions can appear on demand and remain available through focus and touch.",标题用最深的灰:"Headings use the darkest gray",正文浅一号:"Body text is one shade lighter",注释再浅一号:"Notes are one shade lighter still","同一个灰家族拉出层级，不靠颜色":"Create hierarchy with one gray family rather than many colors.","细线是轻量分区示例，复杂控件可使用更明确边界":"Thin lines are a lightweight way to separate sections; complex controls can use clearer boundaries.","\uD83D\uDCD6 团队手册":"\uD83D\uDCD6 Team Manual",适合以文档阅读和编辑为主要任务的界面:"Best for interfaces centered on reading and editing documents.","3 人正在编辑":"3 people are editing",多人协作的工具感界面:"A tool-like interface for collaborative work","\uD83C\uDFE0 我的主页":"\uD83C\uDFE0 My homepage","\uD83D\uDCC5 周计划　\uD83C\uDFAF 目标　\uD83D\uDCA1 灵感":"\uD83D\uDCC5 Weekly Plan \uD83C\uDFAF Goals \uD83D\uDCA1 Inspiration",适合个人知识库与信息整理页面:"Best for personal knowledge bases and information-organizing pages.",表格:"Table",看板:"Kanban",同一份数据可按任务切换不同视图:"The same data can switch between views for different tasks.","新品活动页（文档风）":"New-product campaign page (document style)",营销页通常还需要更明确的品牌与商品表达:"Marketing pages usually need clearer brand and product expression.","商品详情：白底、细线、小灰字":"Product details: white background, thin rules, small gray text",电商页面还需呈现商品特征与购买信息:"An e-commerce page also needs to show product features and purchase information.",触屏无法依赖稳定悬停:"Touchscreens cannot rely on persistent hover.",移动端需提供可发现的点击入口:"Mobile needs a discoverable tap target.","品牌活动页（灰白配色）":"Brand campaign page (gray-and-white palette)","需要强品牌色时，应补充相应的视觉表达":"When a strong brand color is needed, add visual elements that support it.",重点:"Focus","左：一格一个主题；右：内容过多会弱化重点":"Left: One topic per grid; Right: Too much content will weaken the focus.","大格承载重点，小格补充信息，形成阅读节奏":"Large cells carry key points; smaller cells add supporting information and create a reading rhythm.","统一边角与间距关系，具体数值随组件调整":"Keep the relationship between corners and spacing consistent, then adjust exact values for each component.",续航时间:"Battery life",以实测数据为准:"Based on measured results","格内内容按标题、数据和操作的优先级组织":"Within each cell, organize headings, data, and actions by priority.","灰底、白格与深色格可建立统一层级":"A gray background, white cells, and dark cells can create a consistent hierarchy.",适合并列展示少量重点能力与补充信息:"Good for showing a small number of key capabilities alongside supporting details.","M4 芯片":"M4 chip","10 核 CPU \xb7 18h 续航 \xb7 38 万亿次算力":"10-core CPU \xb7 18h battery life \xb7 38 teraflops","发布总结可用网格比较规格，但不是唯一布局":"A launch summary can use a grid to compare specs, but it is not the only layout.",功能页:"Feature page","App「它能做什么」一页讲完":"An app’s “What it does” page, all in one place","仪表盘首页按优先级组织指标、图表和入口":"A dashboard home organizes metrics, charts, and entry points by priority.",卡片承载长文会降低阅读效率:"Putting long-form copy inside cards reduces reading efficiency.",任意调整卡片大小会削弱布局规律:"Arbitrarily resizing cards weakens the layout’s rhythm.",过多卡片会增加扫描负担:"Too many cards increase the scanning burden.","第一步 → 第二步 → 第三步":"First step → Second step → Third step",线性流程宜采用能表达顺序的布局:"Linear flows should use a layout that makes the sequence clear.","① 背景有内容":"① The background has content","② 底色半透明":"② The background color is translucent","③ blur 到位":"③ Enough blur","三要素缺一个，玻璃就不成立":"Without any one of these three elements, the glass effect falls apart.","半透明描边可提示边缘，强度按背景调整":"A translucent outline can define the edge; adjust its strength for the background.","近处更实、远处更透，层次靠「叠」":"Near layers are more opaque and distant ones more transparent; depth comes from stacking them.","有变化的背景更易展示透明层次，素色背景需加强边界":"A varied background makes transparency easier to see; a plain background needs a stronger edge.","加深 tint 托住字 ✓":"Deepen the tint to support the text ✓","太透看不清 ✗":"Too transparent to see clearly ✗","文字区垫一层 tint，保住对比度":"Add a tint behind the text to preserve contrast.","正在播放 ▶":"Now playing ▶",适合需要保留背景画面与浮层关系的媒体界面:"Best for media interfaces that need to retain the relationship between the background image and floating layer.",浮层卡片:"Floating card","浮层透得出背景，前后关系一目了然":"The floating layer reveals the background, making the front-to-back relationship immediately clear.","登 录":"Log in","展示型登录页可借用材质，但表单边界必须清楚":"A display-focused sign-in page can use material effects, but the form boundary must remain clear.","作品集、展示页：轻、透、有未来感":"Portfolios and showcase pages: light, translucent, and futuristic",彩色半透明背景会降低长文阅读对比度:"Colored translucent backgrounds reduce contrast for long-form reading.","浅色朴素后台：没有背景可透，白做":"A plain light back-office page has nothing to show through, so the glass effect adds little.",低性能设备上的全屏模糊会影响滚动和动效:"Full-screen blur can hurt scrolling and animation on lower-powered devices.",移动端需控制范围并准备实色回退:"On mobile, limit its scope and provide a solid-color fallback.",文字对比不足:"Insufficient text contrast","底色过透、模糊过轻会使文字与背景混合":"If the background color is too transparent or the blur is too light, the text will blend with the background.",输入框:"Input box","2-3px 纯黑描边，万物皆有轮廓":"2–3px pure-black outlines: everything gets an edge","左：硬阴影强调直接感；右：软阴影表达更柔和":"Left: hard shadows feel direct. Right: soft shadows feel gentler.","高饱和配色是常见示例，数量和职责需保持清楚":"High-saturation color is a common example, but its amount and purpose must stay clear.",巨大粗黑标题:"Huge bold black headline","粗体可形成海报感，字重按字体和尺寸调整":"Bold type can create a poster feel; adjust the weight for the font and size.",常态:"Default","hover 时阴影位移，像真的按下去":"On hover, the shadow shifts as if the button were being pressed.","别想了，先上线。":"Stop overthinking. Ship it.",独立开发者的不服和直给:"An indie developer’s defiance and directness","一个人做产品，页面也得有性格":"When you build a product solo, the page can have personality too.","电子书 \xa529":"E-book \xa529","Gumroad 式数字商品":"Gumroad-style digital goods","卖课、卖模板、卖电子书的老朋友":"A familiar format for selling courses, templates, and e-books","黑客松 2026":"Hackathon 2026","48 小时":"48 hours",适合需要强节奏和鲜明识别的短期活动页:"Best for short-term campaign pages that need strong rhythm and a distinct identity.","「反精致」也是一种态度":"“Anti-polish” is a stance too","当全世界都极简，粗野就是辨识度":"When everything else is minimalist, rawness can become the differentiator.","银行 App（黑粗边 + 荧光粉）":"Banking app (thick black outlines + fluorescent pink)","金融医疗要信任感，粗野显得不靠谱":"Finance and healthcare need trust; a brutalist treatment can feel unreliable.","企业工具需先保证可信度、扫描效率和状态清晰":"Enterprise tools need credibility, scanability, and clear states first.","政务办事大厅（撞色版）":"Government service portal (high-contrast palette)","正式服务场景应优先庄重、稳定和易操作":"Formal service contexts should prioritize dignity, stability, and ease of use.","\xd7 N 页":"\xd7 N pages","全站每页都撞色，看久了眼睛累":"Using high-contrast colors on every page becomes tiring to look at.","一切对齐到栏线，网格是骨架":"Everything aligns to the column lines; the grid is the skeleton.","无衬线大标题常见左对齐，也可按版面调整":"Sans serif headlines are commonly left aligned and can also be adjusted according to the layout.","黑白配红是经典示例，强调色可随主题选择":"Black, white, and red are a classic example; choose accents to fit the theme.",大:"Large",小:"Small","字号对比建立层级，同时保证小字可读":"Contrast in font size creates hierarchy while keeping small text readable.",阴影:"Shadow",渐变:"Gradient",圆角:"Rounded corners",图标:"Icon","装饰服从信息层级，并非全部禁止":"Decoration should serve the information hierarchy; it is not banned outright.","我们设计系统。":"We design systems.","01 品牌　02 书籍　03 展览":"01 Brand 02 Book 03 Exhibition",适合设计机构与作品集的信息组织:"Suitable for organizing information for design studios and portfolios.",包豪斯一百年:"A Century of Bauhaus","■ 2026.05 深圳":"■ 2026.05 Shenzhen","海报式页面，一屏就是一张海报":"A poster-style page: each screen functions as a poster.",年度报告:"Annual report",适合年报与展览册等结构化内容:"Suitable for structured content such as annual reports and exhibition booklets.","没有图片素材时，文字也可以成为主要视觉":"When images are unavailable, type can become the primary visual.",纯文字也能组成完整页面:"Text alone can form a complete page.","促销活动（黑白红版）":"Promotional campaign (black, white, and red)",促销页面应补充与商品和行动相匹配的节奏:"A promotional page needs a rhythm that fits the product and the desired action.","母婴用品（Helvetica 大字版）":"Baby-products site (large Helvetica headlines)",强调亲和力的品类还需补充相应的视觉线索:"Categories that need warmth also need visual cues that support it.","社交应用（网格 + 黑白）":"Social app (grid + black and white)",社交产品还需根据社区语气与互动任务调整表达:"Social products also need expression that fits the community’s tone and interaction tasks.","内容优先级不清时，网格无法替代信息编辑":"A grid cannot replace content editing when priorities are unclear.",衬线大标题:"Serif display headline","无衬线正文，安静易读":"Sans-serif body copy: calm and readable","两族字体搭配，层次自然分开":"Pairing two type families naturally separates the hierarchy.","分栏可控制行宽，需按语言与屏幕测试":"Columns can control line length, but test them across languages and screen sizes.",刊名:"Title","刊号、页码、期数：「出版物信号」":"Issue number, page number, date: publication cues","行距应按字体、字号和语言测试":"Test line spacing for the typeface, size, and language.","图：玻璃与晨光。摄影 / 360floralflaves":"Image: Glass and Morning Light. Photo by 360floralflaves","图片要经过选择，并用准确图注交代内容与来源":"Choose images carefully and use accurate captions to identify their content and source.",一块茶饼的三十年:"Thirty Years of a Tea Cake","品牌故事 \xb7 第 12 期":"Brand Story \xb7 Issue 12","品牌故事页：有气质的讲法":"Brand story page: a more atmospheric way to tell the story","「慢，是一种能力。」":'"Slowness is a kind of ability."',适合深度长文与专栏内容:"Suitable for in-depth articles and column writing.",去山里住一周:"Spend a Week in the Mountains","文旅、生活方式，天生适合编辑叙事":"Travel and lifestyle content naturally suit editorial storytelling.",年度特辑:"Annual special issue","年报、杂志号，印刷感就是质感":"For annual reports and magazine issues, a print-like feel can add texture.",数据后台使用杂志式排版会增加扫描负担:"Magazine-style layouts make a data back office harder to scan.","客服工作台（首字下沉版）":"Customer-service workspace (drop-cap version)",高频操作界面应优先保证扫描与处理效率:"High-frequency work interfaces should prioritize scanability and processing efficiency.",购买按钮藏在第三栏末尾:"The Buy button is hidden at the end of the third column.","转化型页面：CTA 不能被排版淹没":"Conversion pages: the CTA must not get lost in the layout.",手机屏沿用三栏会使行宽过窄:"Keeping three columns on a phone makes lines too narrow.",小屏应改为单栏或更适合的布局:"On small screens, switch to one column or another more suitable layout.",招聘:"Careers",活动:"Events",核心价值:"Core value",主要优势:"Key benefits",可信证据:"Credible evidence",价值:"Value",优势:"Benefits",证据:"Evidence","?q=按钮&amp;sort=hot":"?q=button&amp;sort=hot","购买 &gt;":"Buy &gt;","圆、方、三角是构图的最小单位":"Circles, squares, and triangles are the smallest units of composition",展期:"Dates",动线:"Route",每个形状负责一件事:"Every shape has one job",展览:"Exhibition",藏品:"Archive",原色只标记功能关系:"Primary colors only mark functional relationships",构成与日常:"Composition and Daily Life",粗无衬线标题配直接层级:"A bold sans-serif headline with direct hierarchy","不居中对称，重量仍然稳定":"Not centered or mirrored, yet the weight stays balanced",设计文献展:"Design Archive Show","6.12 — 9.30":"Jun 12 – Sep 30",展览与文化机构官网:"Sites for exhibitions and cultural institutions",新品牌发布:"New brand launch",几何构成建立品牌识别:"Geometry builds brand recognition","第一周：圆形与平衡":"Week 1: Circles and Balance","第二周：方形与分区":"Week 2: Squares and Sections",按几何主题组织课程:"Courses organized by geometric theme",几何之夜:"A Night of Geometry",海报感主视觉的活动页:"An event page with a poster-like hero","只换配色，内容结构没变":"Only the palette changed; the structure did not","形状与内容无关，只是贴上去":"Shapes unrelated to the content, just pasted on",标题读不清:"An unreadable headline","形状叠压文字，阅读被打断":"Shapes overlapping text break the reading","整段正文都用粗重标题字，两行就累了":"Body copy in heavy display type tires after two lines",正文需要普通字重:"Body text needs a regular weight",沿中轴左右镜像:"Mirrored along the central axis",轮廓层层向内收分:"The contour steps inward layer by layer",从一个中心向外放射:"Rays unfold from a single center",细线与重复构成精致感:"Fine lines and repetition create refinement",深色底配:"A dark base with ",一处金属光泽:"a single metallic sheen",金属色只作小面积点缀:"Metallic color stays a small-area accent","江景套房 \xb7 预订":"River-view suites \xb7 Book now","酒店、珠宝等高端官网":"High-end sites for hotels and jewelry",爵士之夜:"Jazz Night","每周五 20:00":"Fridays 8 PM","剧院、晚宴与展览活动页":"Theater, gala, and exhibition event pages",几何之光系列:"Geometry of Light",强调工艺的高端产品页:"Craft-led luxury product pages",年度颁奖典礼:"Annual Awards Ceremony",庆典与颁奖专题:"Ceremony and award features",金色标题:"A gold headline",金色按钮:"A gold button","只有金色，骨架没有变化":"Only gold, with the skeleton unchanged",藤蔓长曲线属于新艺术:"Long vine curves belong to Art Nouveau",正文压在纹样上读不下去:"Body text over motifs is unreadable",纹样不应进入正文区域:"Motifs should stay out of body text",错位元素破坏中轴:"A misaligned element breaks the axis","作品比例不一，补位保持紧凑":"Mixed ratios packed tight by gap filling",向下滚动继续加载:"Keep scrolling to load more",灵感流连续向下浏览:"An inspiration feed for continuous browsing",降噪耳机:"Noise-canceling headphones",护眼台灯:"Eye-care desk lamp",封面尺寸不一也能保持紧凑:"Mixed cover sizes still stay compact",补位比整行留白更省高度:"Packing saves more height than full-row gaps","步骤 1":"Step 1","步骤 2":"Step 2","步骤 4 排到了步骤 3 前面":"Step 4 lands ahead of Step 3",有先后顺序的内容会被补位打乱:"Ordered content gets shuffled by packing","列不对齐，逐行比较更费力":"Misaligned columns make row comparison harder",手机上保留多列会被压窄:"Keeping multiple columns on phones crushes the cards",长文补位后无法连续读完:"Long articles cannot be read through after packing",品牌介绍:"Brand intro",登录表单:"Login form","一侧品牌，一侧表单":"Brand on one side, the form on the other",个人版:"Personal",企业版:"Business",两类用户各占一半入口:"Two audiences, each with half the page",在线试用:"Start a trial",预约演示:"Book a demo",两条路径并列呈现:"Two paths presented in parallel","方案 A \xb7 按年付":"Plan A \xb7 annual billing","方案 B \xb7 按月付":"Plan B \xb7 monthly billing",两个方案同屏对照:"Two plans compared side by side",全部内容都在右侧:"All content sits on the right","一边只是装饰图，不是分屏":"One side is only decoration, not a split",主从悬殊应使用左侧栏布局:"Unequal weight calls for a sidebar layout",手机上左右分屏被压窄:"Side-by-side halves get crushed on phones","两边都塞满，焦点互相争抢":"Both halves full, and the focus fights itself","18K 金":"18K gold"};function o(e){return String(e||"").replace(/<[^>]+>/g," ").replace(/\{c:([\w-]+)\}/g,"$1").replace(/&(?:[a-z]+|#\d+);/gi," ").replace(/\s+/g," ").trim()}function s(e){return o(e).toLowerCase().replace(/[^\u3400-\u9fffA-Za-z0-9]+/g,"")}function r(e){let t=[...s(e)],n=new Set;for(let e=0;e<t.length-1;e+=1){let a=t[e],i=t[e+1];a&&i&&n.add(a+i)}return n}var l=n(2092),c=n(4531);let d=new Map;function h(e){let t=String(e||"").split("/").filter(Boolean);if("topics"===t[0]||"vibehub-skill"===t[0])return null;let n="zh"===t[0]||"en"===t[0]?t[1]:t[0];return n&&(0,a.hasClientEntry)(n)?n:null}function u(e){return String(e||"").normalize("NFKC").trim().replace(/\s+/g," ").toLocaleLowerCase("en-US")}function m(e,t){return!!(e&&t)&&u(e)===u(t)}function p(e){let t=arguments.length>1&&void 0!==arguments[1]?arguments[1]:"zh";return String(e||"").replace(/\{c:([\w-]+)\}/g,(e,n)=>{let i=(0,a.getClientEntry)(n);if(!i)return n;let o="en"===t?i.name:i.cn,s="en"===t||m(o,i.name)?"":i.name;return'<a class="c-ref c-link" href="'.concat((0,l.s3)(n,t),'" data-ref="').concat(n,'" aria-label="').concat(o).concat(s?" ".concat(s):"",'">').concat(o).concat(s?" <b>".concat(s,"</b>"):"","</a>")}).replace(/`([^`]+)`/g,'<code class="inline-code">$1</code>')}function g(e,t){let n=arguments.length>2&&void 0!==arguments[2]&&arguments[2],a=arguments.length>3?arguments[3]:void 0,l=new Set;return e.map(e=>{let d=e.m&&!l.has(e.m)?e.m:void 0;return e.m&&l.add(e.m),function(e,t){let n=arguments.length>2&&void 0!==arguments[2]&&arguments[2],a=arguments.length>3?arguments[3]:void 0,l=e.m?' class="has-usage-mock"':"",d="<li".concat(l,'><div cl