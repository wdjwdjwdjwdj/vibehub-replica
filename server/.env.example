# ===== 服务 =====
NODE_ENV=development
PORT=3000
# 必须绑 127.0.0.1，生产环境由反向代理转发，不要把 Node 直接暴露到公网
HOST=127.0.0.1

# ===== 数据库 =====
# 本地开发：SQLite（零依赖）
DATABASE_URL="file:./dev.db"
# 生产环境（PostgreSQL）：改为下面这行，并执行 npm run db:deploy
# DATABASE_URL="postgresql://vibehub:password@127.0.0.1:5432/vibehub?schema=public"

# ===== 认证 =====
# 生成方式：openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://127.0.0.1:3000"
# 生产环境必须使用 https:// 地址；NODE_ENV=production 会自动启用 Secure Cookie
BETTER_AUTH_SECURE_COOKIES=false
REQUIRE_EMAIL_VERIFICATION=false

# ===== 邮件（生产环境必填） =====
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="noreply@example.com"
# SMTP_PASSWORD="replace-me"
# SMTP_FROM="起站 <noreply@example.com>"

# GitHub OAuth 暂不启用（无域名时回调地址无法登记）
# 拿到域名后填写这两项并在 src/auth.js 的 socialProviders 中启用即可，无需重构
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ===== 跨域 =====
# 开发期前端跑在 Vite（5173）需要 CORS；生产环境同源部署后这一项可为空
CORS_ORIGIN="http://127.0.0.1:5173"
